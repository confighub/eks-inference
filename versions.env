# Pinned inputs for the render. Everything that determines the bytes in configs/
# lives here, so a render is reproducible from a git checkout alone.
#
# Bump a version here, run `make render`, and review the diff in configs/. That
# diff IS the change review — it is why the rendered output is committed.

# ACK controller chart versions (public.ecr.aws/aws-controllers-k8s/<svc>-chart)
ACK_EC2_CHART_VERSION=1.18.4
ACK_IAM_CHART_VERSION=1.7.3
ACK_EKS_CHART_VERSION=1.16.3

# Kubernetes version passed to `helm template --kube-version`. Charts branch on
# .Capabilities; without pinning this, the render depends on whatever kubectl
# the operator happens to have, which would make configs/ drift for no reason.
# This is the KIND cluster's version (where the ACK controllers run), not EKS.
RENDER_KUBE_VERSION=1.31.0

# Namespace the ACK controllers are installed into.
ACK_NAMESPACE=ack-system

# Workload plane charts.
KARPENTER_CHART_VERSION=1.14.0
NVIDIA_DEVICE_PLUGIN_CHART_VERSION=0.19.3

# NOTE: the GPU AMI alias used to live here. It is now owned by the
# platform-profile Unit (src/platform-profile/profile.yaml), which propagates it
# into karpenter's EC2NodeClass through a ConfigHub link — so there is exactly one
# place to change it per environment rather than a literal in versions.env and
# another in nodeclasses.yaml that could drift apart.
#
# To find a current value:
#   aws ssm get-parameter --region <r> \
#     --name /aws/service/eks/optimized-ami/<k8s>/amazon-linux-2023/x86_64/nvidia/recommended/image_id
#   aws ec2 describe-images --image-ids <id> --query 'Images[0].Name'
# The trailing "-vYYYYMMDD" of the AMI name is the alias version.

# Registry the config bundles are pushed to.
#
# Namespaced under the stack name: component names like "karpenter" and
# "aws-network" are far too generic to sit directly in a shared configs/
# namespace alongside unrelated bundles. ghcr.io/confighub/configs/karpenter
# would squat the name any Karpenter config bundle would want.
#
# CI overrides this with ghcr.io/<repo-owner>/configs/eks-inference so a fork
# publishes to its own org rather than to confighub's.
REGISTRY=ghcr.io/confighub/configs/eks-inference
